{
  "name": "losrobles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run build -w @losrobles/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @losrobles/shared",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @losrobles/shared && npm run build -w @losrobles/api -w @losrobles/notificaciones -w @losrobles/web",
    "predev": "npm run build -w @losrobles/shared",
    "dev": "concurrently --kill-others --names shared,api,notificaciones,web \"npm run dev -w @losrobles/shared\" \"npm run dev -w @losrobles/api\" \"npm run dev -w @losrobles/notificaciones\" \"npm run dev -w @losrobles/web\"",
    "db:migrate": "npm run db:migrate -w @losrobles/api",
    "db:seed": "npm run db:seed -w @losrobles/api",
    "prepare": "node .husky/install.js",
    "lock": "node scripts/lock-linux.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
